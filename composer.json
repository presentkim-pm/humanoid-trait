{
  "name": "presentkim/humanoid-trait",
  "description": "Trait that turns a custom entity into a humanoid (player-looking) entity for axolotl-pm/PocketMine-MP",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "pocketmine/pocketmine-mp": "^5.0",
    "ramsey/uuid": "^4.0"
  },
  "require-dev": {
    "axolotl-pm/pocketmine-mp": "^5.51",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "kim\\present\\traits\\humanoid\\": "src/kim/present/traits/humanoid/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "kim\\present\\traits\\humanoid\\tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
